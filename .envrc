# Fork-only. Put the agent gh policy shim first on PATH so a coding agent's `gh pr ready` runs the
# ship gate first (scripts/fork-prepare.mjs installs it on `prepare`).
PATH_add .tools/bin

# Default bare `gh` commands to the fork instead of gh's upstream-parent default
# (pingdotgg/t3code). Explicit `--repo` still overrides.
export GH_REPO="${T3CODE_FORK_REPOSITORY:-patroza/t3code}"
